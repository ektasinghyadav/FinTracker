# Copy this file to .env and fill in your values
# Never commit .env to git

# ── Database ──────────────────────────────────────────────────────────────────
# Get from: mongodb.com/atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/fintracker

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Set this to "production" on Vercel (add as environment variable in dashboard)
NODE_ENV=development

# ── Authentication ────────────────────────────────────────────────────────────
# Any long random string — generate one at randomkeygen.com
JWT_SECRET=your_super_secret_key_here

# ── AI Services ───────────────────────────────────────────────────────────────
# Groq (free tier, open-source models) — get a key from console.groq.com/keys
# Without a key the app still works: expense sentences are read with simple
# keyword rules, and the AI summary shows a clear "not available" message.
GROQ_API_KEY=your_groq_api_key_here

# Optional: which Groq model to use (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b
