# Copy this file to .env and fill in your values
# Never commit .env to git

# ── Database ──────────────────────────────────────────────────────────────────
# Get from: mongodb.com/atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/fintracker

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Set this to "production" on Vercel (add as environment variable in dashboard)
NODE_ENV=development

# ── Authentication ────────────────────────────────────────────────────────────
# Any long random string — generate one at randomkeygen.com
JWT_SECRET=your_super_secret_key_here

# ── AI Services ───────────────────────────────────────────────────────────────
# Hugging Face — get from huggingface.co/settings/tokens (free)
HUGGINGFACE_API_KEY=hf_your_token_here

# Google Gemini — get from aistudio.google.com/apikey (free)
GEMINI_API_KEY=your_gemini_api_key_here
